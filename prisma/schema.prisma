generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  apiKey    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]
  users   User[]
  leads   Lead[]
  outreachEvents OutreachEvent[]
}

model Domain {
  id        String   @id @default(cuid())
  hostname  String   @unique
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  ATTORNEY
  STAFF
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String
  role           Role     @default(STAFF)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  accounts   Account[]
  sessions   Session[]
  leadEvents LeadEvent[]
  outreachEvents OutreachEvent[]
}

enum LeadStatus {
  NEW
  REVIEWED
  MAIL_QUEUED
  MAILED
  CLIENT_RESPONDED
  CONTACT_PERMITTED
  QUALIFIED
  RETAINED
  CLOSED_WON
  CLOSED_LOST
  DISMISSED
}

model Lead {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  source     String
  fingerprint String?
  sourceId    String?
  sourceUrl   String?
  rawData     Json?

  firstName  String?
  lastName   String?
  fullName   String?

  phone      String?
  email      String?

  county     String?
  caseNumber String?
  arrestDate DateTime?
  bookingDate    DateTime?
  chargeSeverity String?
  disposition    String?
  courtName      String?
  jailName       String?
  address        String?
  city           String?
  state          String?
  zip            String?

  charge     String?
  bondAmount Int?
  bondType      String?
  custodyStatus String?
  notes      String?

  // Lead scoring
  score      Int        @default(0)
  priority   String     @default("LOW")
  lastScoredAt DateTime?

  status     LeadStatus @default(NEW)

  // Compliance: outreach beyond direct mail is gated on these.
  // See src/lib/compliance.ts for the enforcement point.
  clientResponded    Boolean   @default(false)
  clientRespondedAt  DateTime?
  contactPermitted   Boolean   @default(false)
  contactPermittedAt DateTime?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  enrichments    Enrichment[]
  events         LeadEvent[]
  outreachEvents OutreachEvent[]

  @@unique([tenantId, source, fingerprint], name: "tenantId_source_fingerprint")
}

model Enrichment {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  provider  String
  score     Int      @default(0)
  priority  String   @default("LOW")
  data      Json
  createdAt DateTime @default(now())
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
}

// Per-channel outreach record. DIRECT_MAIL is the only channel a lead can
// receive before contactPermitted is true — see src/lib/compliance.ts,
// which every code path creating an EMAIL/PHONE/SMS event must call first.
enum OutreachChannel {
  DIRECT_MAIL
  EMAIL
  PHONE
  SMS
  INTERNAL_NOTE
}

enum OutreachStatus {
  NOT_STARTED
  QUEUED
  SENT
  DELIVERED
  RESPONDED
  FAILED
}

model OutreachEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?  @relation(fields: [userId], references: [id])

  channel     OutreachChannel
  status      OutreachStatus  @default(NOT_STARTED)
  templateId  String?
  notes       String?
  sentAt      DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
